{
  "name": "dsh-fonts",
  "version": "0.1.1",
  "description": "Font system plugin for DeepSeek Harness: bundled OFL webfonts served offline, user-imported custom fonts, and a ctx.fonts registry other plugins can extend",
  "license": "MIT",
  "author": "zhijun-dai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhijun-dai/dsh-Fonts.git"
  },
  "keywords": [
    "deepseek-harness", "dsh", "plugin", "dsh-plugin", "fonts",
    "typography", "webfonts", "web-ui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types",
    "cordis.patch.yml",
    "data"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "scripts": {
    "generate": "node scripts/gen-client.mjs"
  }
}
